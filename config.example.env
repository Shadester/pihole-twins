# Pi-hole Twins - Example Configuration
# Copy this file to .env and fill in your values.
#
# Server hostnames or IP addresses (replace with your own)
pihole1_host=192.168.1.XXX
pihole2_host=192.168.1.YYY

# SSH settings (optional)
# ssh_user=root
# ssh_port=22
# ssh_key=~/.ssh/id_rsa

# Stats interval in seconds (default: 60)
# stats_interval=60
