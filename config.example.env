# Pi-hole Twins — example .env file
# Place this in the project root (pihole-twins/.env)
# Values here override config.json for these servers only.

# Format: SERVERNAME_HOSTNAME=ip_or_host
# Server names are the keys in config.json's "servers" dict.

PIHOLE1_HOSTNAME=192.168.1.10
PIHOLE2_HOSTNAME=192.168.1.11
